# ==============================================================================
# ORION Backend Environment Variables (Render / Cloud / Local)
# ==============================================================================

# Server Port (Render sets this dynamically)
PORT=8000

# Database Configuration (PostgreSQL in cloud, SQLite in local development)
# Local: sqlite:///orion_verified.db
# Cloud (Render/Neon/Supabase): postgresql://user:password@host:5432/orion
DATABASE_URL=sqlite:///orion_verified.db

# CORS Allowed Origins (Comma-separated for multiple frontend domains)
# Example: https://orion-dashboard.vercel.app,http://localhost:3000
ORION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Agent Provider ("local" for built-in coordinator, "adya" for Adya adapter-ready mode)
ORION_AGENT_PROVIDER=local

# Application Settings
ORION_APP_NAME=ORION
ORION_DEBUG=False
